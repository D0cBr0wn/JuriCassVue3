{
  "compilerOptions": {
    "noImplicitAny": false,
    "noImplicitThis": false,
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "moduleResolution": "node",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"],
    "types": ["vitest/globals"]
  },
  "vueCompilerOptions": {
    "target": 3
    // "target": 2, // For Vue version <= 2.6.14
  },
  "include": ["@/**/*.ts", "src/**/*", "@/**/*.tsx", "@/**/*.vue", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["node_modules"]
}
